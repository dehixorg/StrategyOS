PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/strategyos?appName=Cluster0
JWT_SECRET=your_jwt_secret_here

# SoSoValue API (get key at sosovalue.com/developer)
SOSOVALUE_API_KEY=SOSO-your_key_here

# SoDEX API
SODEX_API_KEY=your_sodex_api_key
SODEX_WALLET_PRIVATE_KEY=your_evm_wallet_private_key
SODEX_ACCOUNT_ID=your_sodex_account_id
SODEX_NETWORK=testnet

# ValueChain Smart Contract
VALUECHAIN_RPC=https://mainnet-gw.sodex.dev
CONTRACT_ADDRESS=0xYourStrategyOSContractAddress
SOSO_TOKEN_ADDRESS=0xYourSOSOTokenAddress
DEPLOYER_PRIVATE_KEY=your_wallet_private_key
TREASURY_WALLET=0xYourTreasuryWalletAddress

# CORS
FRONTEND_URL=https://your-app.vercel.app
